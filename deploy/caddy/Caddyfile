{$PIR_HOSTS} {
	handle /metrics {
		respond 404
	}

	# Raw tier rows are not privacy-preserving. Keep them off the public proxy.
	handle /tier1/row/* {
		respond 403
	}

	# The APM dashboard is served without authentication. It exposes only
	# aggregate metrics and host health, never per-request or per-user data.
	handle_path /apm* {
		reverse_proxy 127.0.0.1:3002
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
